{
  "$schema": "vscode://schemas/color-theme",
  "name": "LiG Preview Dark",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": {
      "foreground": "#7cbd85"
    },
    "class": {
      "foreground": "#8691ca"
    },
    "enum": {
      "foreground": "#97a5ed"
    },
    "interface": {
      "foreground": "#8691ca"
    },
    "struct": {
      "foreground": "#8691ca"
    },
    "typeParameter": {
      "foreground": "#8691ca"
    },
    "type": {
      "foreground": "#8691ca"
    },
    "parameter": {
      "foreground": "#f8f8f8"
    },
    "variable": {
      "foreground": "#f8f8f8"
    },
    "property": {
      "foreground": "#b7b7b7"
    },
    "enumMember": {
      "foreground": "#97a5ed"
    },
    "decorator": {
      "foreground": "#7cbd85"
    },
    "event": {
      "foreground": "#dc9b64"
    },
    "function": {
      "foreground": "#dc9b64"
    },
    "method": {
      "foreground": "#dc9b64"
    },
    "macro": {
      "foreground": "#eab489"
    },
    "label": {
      "foreground": "#97a5ed"
    },
    "comment": {
      "foreground": "#7a7a7a"
    },
    "string": {
      "foreground": "#989898"
    },
    "keyword": {
      "foreground": "#b7b7b7"
    },
    "number": {
      "foreground": "#97a5ed"
    },
    "regexp": {
      "foreground": "#b0bdf8"
    },
    "operator": {
      "foreground": "#989898"
    },
    "boolean": {
      "foreground": "#97a5ed"
    },
    "namespace.declaration": {
      "foreground": "#9cd1a2"
    },
    "namespace.definition": {
      "foreground": "#9cd1a2"
    },
    "class.declaration": {
      "foreground": "#b0bdf8"
    },
    "class.definition": {
      "foreground": "#b0bdf8"
    },
    "enum.declaration": {
      "foreground": "#b0bdf8"
    },
    "enum.definition": {
      "foreground": "#b0bdf8"
    },
    "interface.declaration": {
      "foreground": "#b0bdf8"
    },
    "interface.definition": {
      "foreground": "#b0bdf8"
    },
    "struct.declaration": {
      "foreground": "#b0bdf8"
    },
    "struct.definition": {
      "foreground": "#b0bdf8"
    },
    "typeParameter.declaration": {
      "foreground": "#b0bdf8"
    },
    "typeParameter.definition": {
      "foreground": "#b0bdf8"
    },
    "type.declaration": {
      "foreground": "#b0bdf8"
    },
    "type.definition": {
      "foreground": "#b0bdf8"
    },
    "parameter.declaration": {
      "foreground": "#7cbd85"
    },
    "parameter.definition": {
      "foreground": "#7cbd85"
    },
    "property.declaration": {
      "foreground": "#7cbd85"
    },
    "property.definition": {
      "foreground": "#7cbd85"
    },
    "enumMember.declaration": {
      "foreground": "#b0bdf8"
    },
    "enumMember.definition": {
      "foreground": "#b0bdf8"
    },
    "event.declaration": {
      "foreground": "#eab489"
    },
    "event.definition": {
      "foreground": "#eab489"
    },
    "function.declaration": {
      "foreground": "#eab489"
    },
    "function.definition": {
      "foreground": "#eab489"
    },
    "method.declaration": {
      "foreground": "#eab489"
    },
    "method.definition": {
      "foreground": "#eab489"
    },
    "*.defaultLibrary": {
      "italic": true
    },
    "*.deprecated": {
      "strikethrough": true
    },
    "magicFunction": {
      "foreground": "#dc9b64"
    },
    "magicFunction.declaration": {
      "foreground": "#eab489"
    },
    "selfParameter": {
      "foreground": "#b0bdf8"
    },
    "selfParameter.declaration": {
      "foreground": "#9cd1a2"
    },
    "clsParameter": {
      "foreground": "#b0bdf8"
    },
    "clsParameter.declaration": {
      "foreground": "#9cd1a2"
    },
    "class.builtin": {
      "foreground": "#b0bdf8"
    },
    "class.typeHint": {
      "foreground": "#8691ca"
    },
    "class.decorator": {
      "foreground": "#7cbd85"
    },
    "function.builtin": {
      "foreground": "#eab489"
    },
    "function.decorator": {
      "foreground": "#7cbd85"
    },
    "property.decorator": {
      "foreground": "#f8f8f8"
    }
  },
