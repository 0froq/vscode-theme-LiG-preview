    "terminal.ansiRed": "#e6908d",
    "terminal.ansiBrightRed": "#f3aba8",
    "terminal.ansiGreen": "#7cbd85",
    "terminal.ansiBrightGreen": "#9cd1a2",
    "terminal.ansiYellow": "#baac5a",
    "terminal.ansiBrightYellow": "#cdc382",
    "terminal.ansiBlue": "#97a5ed",
    "terminal.ansiBrightBlue": "#b0bdf8",
    "terminal.ansiMagenta": "#cd94cf",
    "terminal.ansiBrightMagenta": "#ddaedf",
    "terminal.ansiCyan": "#48c0be",
    "terminal.ansiBrightCyan": "#7bd3d1",
    "terminal.ansiWhite": "#b7b7b7",
    "terminal.ansiBrightWhite": "#f8f8f8",
    "gitDecoration.addedResourceForeground": "#7cbd85",
    "gitDecoration.modifiedResourceForeground": "#baac5a",
