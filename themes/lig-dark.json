  "tokenColors": [
    {
      "name": "LiG keyword",
      "scope": [
        "keyword",
        "storage.type"
      ],
      "settings": {
        "foreground": "#b7b7b7"
      }
    },
    {
      "name": "LiG keyword.modifier",
      "scope": [
        "storage.modifier",
        "meta.directive",
        "entity.other.attribute-name.directive"
      ],
      "settings": {
        "foreground": "#7cbd85"
      }
    },
    {
      "name": "LiG keyword.action",
      "scope": [
        "keyword.control.return",
        "keyword.control.throw",
        "keyword.control.trycatch",
        "keyword.control.flow",
        "storage.modifier.async",
        "storage.type.function.async"
      ],
      "settings": {
        "foreground": "#dc9b64"
      }
    },
    {
      "name": "LiG variable",
      "scope": [
        "variable.other.readwrite",
        "variable.other.object",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#f8f8f8"
      }
    },
    {
      "name": "LiG variable.builtin",
      "scope": [
        "variable.language",
        "variable.parameter.function.language.special"
      ],
      "settings": {
        "foreground": "#b0bdf8"
      }
    },
    {
      "name": "LiG parameter.binding",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#7cbd85"
      }
    },
    {
      "name": "LiG property",
      "scope": [
        "variable.other.property",
        "support.variable.property",
        "meta.object-literal.key",
        "meta.property-name",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#b7b7b7"
      }
    },
    {
      "name": "LiG module",
      "scope": [
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#7cbd85"
      }
    },
    {
      "name": "LiG tag",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#7cbd85"
      }
    },
    {
      "name": "LiG type.reference",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#8691ca"
      }
    },
    {
      "name": "LiG type.definition",
      "scope": [
        "meta.class entity.name.type",
        "meta.interface entity.name.type",
        "meta.type.declaration entity.name.type",
        "entity.name.type.alias",
        "entity.name.type.interface"
      ],
      "settings": {
        "foreground": "#b0bdf8"
      }
    },
    {
      "name": "LiG function.definition",
      "scope": [
        "entity.name.function"
      ],
      "settings": {
        "foreground": "#eab489"
      }
    },
    {
      "name": "LiG function.call",
      "scope": [
        "support.function",
        "meta.function-call entity.name.function",
        "meta.function-call.generic entity.name.function"
      ],
      "settings": {
        "foreground": "#dc9b64"
      }
    },
    {
      "name": "LiG function.definition",
      "scope": [
        "support.function.builtin",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#eab489"
      }
    },
    {
      "name": "LiG number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#97a5ed"
      }
    },
    {
      "name": "LiG constant",
      "scope": [
        "constant.language",
        "entity.name.constant",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#97a5ed"
      }
    },
    {
      "name": "LiG string",
      "scope": [
        "string",
        "constant.character"
      ],
      "settings": {
        "foreground": "#989898"
      }
    },
    {
      "name": "LiG escape",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#b0bdf8"
      }
    },
    {
      "name": "LiG operator",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#989898"
      }
    },
    {
      "name": "LiG punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "delimiter"
      ],
      "settings": {
        "foreground": "#7a7a7a"
      }
    },
    {
      "name": "LiG comment",
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#7a7a7a"
      }
    },
    {
      "name": "LiG markup.heading",
      "scope": [
        "markup.heading",
        "markup.heading entity.name"
      ],
      "settings": {
        "foreground": "#f8f8f8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "LiG markup.strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#f8f8f8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "LiG markup.italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "LiG markup.quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#b7b7b7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "LiG markup.link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#97a5ed",
        "fontStyle": "underline"
      }
    },
    {
      "name": "LiG markup.raw",
      "scope": [
        "markup.raw"
      ],
      "settings": {
        "foreground": "#b7b7b7"
      }
    }
  ]
}
