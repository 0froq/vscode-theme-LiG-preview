  "tokenColors": [
    {
      "name": "LiG keyword",
      "scope": [
        "keyword",
        "storage.type"
      ],
      "settings": {
        "foreground": "#5d5d5d"
      }
    },
    {
      "name": "LiG keyword.modifier",
      "scope": [
        "storage.modifier",
        "meta.directive",
        "entity.other.attribute-name.directive"
      ],
      "settings": {
        "foreground": "#4b8053"
      }
    },
    {
      "name": "LiG keyword.action",
      "scope": [
        "keyword.control.return",
        "keyword.control.throw",
        "keyword.control.trycatch",
        "keyword.control.flow",
        "storage.modifier.async",
        "storage.type.function.async"
      ],
      "settings": {
        "foreground": "#986438"
      }
    },
    {
      "name": "LiG variable",
      "scope": [
        "variable.other.readwrite",
        "variable.other.object",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#2e2e2e"
      }
    },
    {
      "name": "LiG variable.builtin",
      "scope": [
        "variable.language",
        "variable.parameter.function.language.special"
      ],
      "settings": {
        "foreground": "#4f5990"
      }
    },
    {
      "name": "LiG parameter.binding",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#4b8053"
      }
    },
    {
      "name": "LiG property",
      "scope": [
        "variable.other.property",
        "support.variable.property",
        "meta.object-literal.key",
        "meta.property-name",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#5d5d5d"
      }
    },
    {
      "name": "LiG module",
      "scope": [
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#4b8053"
      }
    },
    {
      "name": "LiG tag",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#4b8053"
      }
    },
    {
      "name": "LiG type.reference",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#7682bc"
      }
    },
    {
      "name": "LiG type.definition",
      "scope": [
        "meta.class entity.name.type",
        "meta.interface entity.name.type",
        "meta.type.declaration entity.name.type",
        "entity.name.type.alias",
        "entity.name.type.interface"
      ],
      "settings": {
        "foreground": "#4f5990"
      }
    },
    {
      "name": "LiG function.definition",
      "scope": [
        "entity.name.function"
      ],
      "settings": {
        "foreground": "#825023"
      }
    },
    {
      "name": "LiG function.call",
      "scope": [
        "support.function",
        "meta.function-call entity.name.function",
        "meta.function-call.generic entity.name.function"
      ],
      "settings": {
        "foreground": "#986438"
      }
    },
    {
      "name": "LiG function.definition",
      "scope": [
        "support.function.builtin",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#825023"
      }
    },
    {
      "name": "LiG number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#626da6"
      }
    },
    {
      "name": "LiG constant",
      "scope": [
        "constant.language",
        "entity.name.constant",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#626da6"
      }
    },
    {
      "name": "LiG string",
      "scope": [
        "string",
        "constant.character"
      ],
      "settings": {
        "foreground": "#696969"
      }
    },
    {
      "name": "LiG escape",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#4f5990"
      }
    },
    {
      "name": "LiG operator",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#696969"
      }
    },
    {
      "name": "LiG punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "delimiter"
      ],
      "settings": {
        "foreground": "#989898"
      }
    },
    {
      "name": "LiG comment",
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#989898"
      }
    },
    {
      "name": "LiG markup.heading",
      "scope": [
        "markup.heading",
        "markup.heading entity.name"
      ],
      "settings": {
        "foreground": "#2e2e2e",
        "fontStyle": "bold"
      }
    },
    {
      "name": "LiG markup.strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#2e2e2e",
        "fontStyle": "bold"
      }
    },
    {
      "name": "LiG markup.italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "LiG markup.quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#5d5d5d",
        "fontStyle": "italic"
      }
    },
    {
      "name": "LiG markup.link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#626da6",
        "fontStyle": "underline"
      }
    },
    {
      "name": "LiG markup.raw",
      "scope": [
        "markup.raw"
      ],
      "settings": {
        "foreground": "#5d5d5d"
      }
    }
  ]
}
