    "tab.inactiveBackground": "#ffffff",
    "tab.activeBackground": "#ffffff",
    "tab.hoverBackground": "#f8f8f8",
    "tab.unfocusedHoverBackground": "#ffffff",
    "tab.border": "#d7d7d7",
    "tab.unfocusedActiveBorderTop": "#d7d7d7",
    "tab.activeBorder": "#d7d7d7",
    "tab.unfocusedActiveBorder": "#d7d7d7",
    "tab.activeBorderTop": "#2e2e2e",
    "breadcrumb.foreground": "#989898",
    "breadcrumb.focusForeground": "#5d5d5d",
    "breadcrumb.background": "#ffffff",
    "breadcrumb.activeSelectionForeground": "#2e2e2e",
    "breadcrumbPicker.background": "#ffffff",
