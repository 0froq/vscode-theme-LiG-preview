    "notificationsWarningIcon.foreground": "#7e732e",
    "notificationsInfoIcon.foreground": "#138281",
    "pickerGroup.border": "#d7d7d7",
    "pickerGroup.foreground": "#5d5d5d",
    "quickInput.background": "#ffffff",
    "quickInput.foreground": "#5d5d5d",
    "quickInputList.focusBackground": "#f8f8f8",
    "statusBar.foreground": "#5d5d5d",
    "statusBar.background": "#eeeeee",
    "statusBar.border": "#ffffff",
    "statusBar.noFolderBackground": "#ffffff",
    "statusBar.debuggingBackground": "#ffffff",
    "statusBar.debuggingForeground": "#5d5d5d",
    "statusBarItem.prominentBackground": "#f8f8f8",
    "editorGroupHeader.tabsBackground": "#ffffff",
    "editorGroupHeader.tabsBorder": "#d7d7d7",
    "editorGroup.border": "#d7d7d7",
    "tab.activeForeground": "#2e2e2e",
