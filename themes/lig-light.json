{
  "$schema": "vscode://schemas/color-theme",
  "name": "LiG Preview Light",
  "type": "light",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": {
      "foreground": "#4b8053"
    },
    "class": {
      "foreground": "#7682bc"
    },
    "enum": {
      "foreground": "#626da6"
    },
    "interface": {
      "foreground": "#7682bc"
    },
    "struct": {
      "foreground": "#7682bc"
    },
    "typeParameter": {
      "foreground": "#7682bc"
    },
    "type": {
      "foreground": "#7682bc"
    },
    "parameter": {
      "foreground": "#2e2e2e"
    },
    "variable": {
      "foreground": "#2e2e2e"
    },
    "property": {
      "foreground": "#5d5d5d"
    },
    "enumMember": {
      "foreground": "#626da6"
    },
    "decorator": {
      "foreground": "#4b8053"
    },
    "event": {
      "foreground": "#986438"
    },
    "function": {
      "foreground": "#986438"
    },
    "method": {
      "foreground": "#986438"
    },
    "macro": {
      "foreground": "#825023"
    },
    "label": {
      "foreground": "#626da6"
    },
    "comment": {
      "foreground": "#989898"
    },
    "string": {
      "foreground": "#696969"
    },
    "keyword": {
      "foreground": "#5d5d5d"
    },
    "number": {
      "foreground": "#626da6"
    },
    "regexp": {
      "foreground": "#4f5990"
    },
    "operator": {
      "foreground": "#696969"
    },
    "boolean": {
      "foreground": "#626da6"
    },
    "namespace.declaration": {
      "foreground": "#366b40"
    },
    "namespace.definition": {
      "foreground": "#366b40"
    },
    "class.declaration": {
      "foreground": "#4f5990"
    },
    "class.definition": {
      "foreground": "#4f5990"
    },
    "enum.declaration": {
      "foreground": "#4f5990"
    },
    "enum.definition": {
      "foreground": "#4f5990"
    },
    "interface.declaration": {
      "foreground": "#4f5990"
    },
    "interface.definition": {
      "foreground": "#4f5990"
    },
    "struct.declaration": {
      "foreground": "#4f5990"
    },
    "struct.definition": {
      "foreground": "#4f5990"
    },
    "typeParameter.declaration": {
      "foreground": "#4f5990"
    },
    "typeParameter.definition": {
      "foreground": "#4f5990"
    },
    "type.declaration": {
      "foreground": "#4f5990"
    },
    "type.definition": {
      "foreground": "#4f5990"
    },
    "parameter.declaration": {
      "foreground": "#4b8053"
    },
    "parameter.definition": {
      "foreground": "#4b8053"
    },
    "property.declaration": {
      "foreground": "#4b8053"
    },
    "property.definition": {
      "foreground": "#4b8053"
    },
    "enumMember.declaration": {
      "foreground": "#4f5990"
    },
    "enumMember.definition": {
      "foreground": "#4f5990"
    },
    "event.declaration": {
      "foreground": "#825023"
    },
    "event.definition": {
      "foreground": "#825023"
    },
    "function.declaration": {
      "foreground": "#825023"
    },
    "function.definition": {
      "foreground": "#825023"
    },
    "method.declaration": {
      "foreground": "#825023"
    },
    "method.definition": {
      "foreground": "#825023"
    },
    "*.defaultLibrary": {
      "italic": true
    },
    "*.deprecated": {
      "strikethrough": true
    },
    "magicFunction": {
      "foreground": "#986438"
    },
    "magicFunction.declaration": {
      "foreground": "#825023"
    },
    "selfParameter": {
      "foreground": "#4f5990"
    },
    "selfParameter.declaration": {
      "foreground": "#366b40"
    },
    "clsParameter": {
      "foreground": "#4f5990"
    },
    "clsParameter.declaration": {
      "foreground": "#366b40"
    },
    "class.builtin": {
      "foreground": "#4f5990"
    },
    "class.typeHint": {
      "foreground": "#7682bc"
    },
    "class.decorator": {
      "foreground": "#4b8053"
    },
    "function.builtin": {
      "foreground": "#825023"
    },
    "function.decorator": {
      "foreground": "#4b8053"
    },
    "property.decorator": {
      "foreground": "#2e2e2e"
    }
  },
