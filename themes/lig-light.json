    "editor.inactiveSelectionBackground": "#f0f0f0",
    "editor.selectionBackground": "#f0f0f0",
    "editor.selectionHighlightBackground": "#f0f0f0",
    "editor.wordHighlightBackground": "#4b805320",
    "editor.wordHighlightStrongBackground": "#4b805330",
    "editorBracketMatch.background": "#ffffff",
    "diffEditor.insertedTextBackground": "#4b805322",
    "diffEditor.removedTextBackground": "#a05b5a22",
    "scrollbar.shadow": "#d7d7d7",
    "scrollbarSlider.background": "#f8f8f8",
    "scrollbarSlider.hoverBackground": "#f8f8f8",
    "scrollbarSlider.activeBackground": "#f8f8f8",
    "editorOverviewRuler.border": "#d7d7d7",
    "panel.background": "#ffffff",
