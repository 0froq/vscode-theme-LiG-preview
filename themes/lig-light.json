    "gitDecoration.untrackedResourceForeground": "#989898",
    "gitDecoration.ignoredResourceForeground": "#989898",
    "gitDecoration.conflictingResourceForeground": "#7e732e",
    "gitDecoration.submoduleResourceForeground": "#5d5d5d",
