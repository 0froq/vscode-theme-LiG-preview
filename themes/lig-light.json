    "panelTitle.activeForeground": "#2e2e2e",
    "panelTitle.inactiveForeground": "#989898",
    "panelInput.border": "#d7d7d7",
    "terminal.foreground": "#5d5d5d",
    "terminal.selectionBackground": "#f0f0f0",
    "terminal.ansiBlack": "#ffffff",
    "terminal.ansiBrightBlack": "#989898",
    "terminal.ansiRed": "#a05b5a",
    "terminal.ansiBrightRed": "#894746",
    "terminal.ansiGreen": "#4b8053",
    "terminal.ansiBrightGreen": "#366b40",
    "terminal.ansiYellow": "#7e732e",
    "terminal.ansiBrightYellow": "#6a5e16",
    "terminal.ansiBlue": "#626da6",
    "terminal.ansiBrightBlue": "#4f5990",
    "terminal.ansiMagenta": "#8c5f8f",
    "terminal.ansiBrightMagenta": "#774b79",
    "terminal.ansiCyan": "#138281",
    "terminal.ansiBrightCyan": "#006c6b",
    "terminal.ansiWhite": "#5d5d5d",
    "terminal.ansiBrightWhite": "#2e2e2e",
